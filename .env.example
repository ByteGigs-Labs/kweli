# Copy to .env and fill in. Never commit .env.

# --- Database (docker compose) ---
POSTGRES_USER=kweli
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kweli
DATABASE_URL=postgresql+psycopg://kweli:change-me@127.0.0.1:5432/kweli

# --- App ---
CORS_ORIGINS=["http://localhost:5173"]
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
API_PORT=8000
# Demo login created by `python -m scripts.seed` (password: 10+ characters)
DEMO_USER_EMAIL=amina@demo.kweli.test
DEMO_USER_NAME=Amina Wanjiru
DEMO_USER_PASSWORD=
# 32 random bytes, base64. Generate: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
VAULT_MASTER_KEY=

# --- PayPal (SANDBOX ONLY) ---
# developer.paypal.com > Apps & Credentials > Sandbox > your app
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set after registering the webhook URL in the app settings
PAYPAL_WEBHOOK_ID=

# --- AI ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
